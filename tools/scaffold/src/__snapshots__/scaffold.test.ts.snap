            "of": [
              {
                "kind": "timer_elapsed",
                "ms": 700
              },
              {
                "kind": "grounded"
              }
            ]
          }
        }
      ]
    },
    "hop": {
      "onEnter": [
        {
          "kind": "move_toward_player",
          "speed": 60
        },
        {
          "kind": "jump",
          "vy": -120
        }
      ],
      "update": [],
      "transitions": [
        {
          "to": "wait",
          "when": {
            "kind": "all",
            "of": [
              {
                "kind": "timer_elapsed",
                "ms": 300
              },
              {
                "kind": "grounded"
              }
            ]
          }
        }
      ]
    }
  }
}
