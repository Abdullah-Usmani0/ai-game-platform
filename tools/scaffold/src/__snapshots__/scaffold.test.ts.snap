          "kind": "emit",
          "event": "custom:bite"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
        {
          "to": "stagger",
          "when": {
            "kind": "took_damage"
          }
        },
        {
          "to": "chase",
          "when": {
            "kind": "timer_elapsed",
            "ms": 400
          }
        }
      ]
    },
    "stagger": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "hurt"
        },
        {
          "kind": "move_away_from_player",
          "speed": 70
        }
      ],
      "update": [],
      "transitions": [
        {
          "to": "chase",
          "when": {
            "kind": "timer_elapsed",
            "ms": 220
          }
        }
      ]
    }
  }
}
