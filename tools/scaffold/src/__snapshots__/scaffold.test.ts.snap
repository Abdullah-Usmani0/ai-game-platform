  "content/behaviour/warden.fsm.json": "{
  "version": 1,
  "id": "warden",
  "designNotes": "Boss: stalks; slams with a long wind-up up close (an area hit); fires ember rings at range; enrages below half health (faster, slams throw rings too). Never staggers.",
  "initial": "wait",
  "states": {
    "wait": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "idle"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
        {
          "to": "stalk",
          "when": {
            "kind": "player_in_sight",
            "px": 72
          }
        },
        {
          "to": "stalk",
          "when": {
            "kind": "took_damage"
          }
        }
      ]
    },
    "stalk": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "run"
        }
      ],
      "update": [
        {
          "kind": "move_toward_player",
          "speed": 26
        }
      ],
      "transitions": [
        {
          "to": "roar",
          "when": {
            "kind": "all",
            "of": [
              {
                "kind": "hp_below",
                "fraction": 0.5
              },
              {
                "kind": "flag",
                "name": "enraged",
                "is": false
              }
            ]
          }
        },
        {
          "to": "windup",
          "when": {
            "kind": "player_within",
            "px": 22
          }
        },
        {
          "to": "aim",
          "when": {
            "kind": "timer_elapsed",
            "ms": 2200
          }
        }
      ]
    },
    "windup": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "windup"
        },
        {
          "kind": "emit",
          "event": "custom:windup"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
        {
          "to": "slam",
          "when": {
            "kind": "timer_elapsed",
            "ms": 650
          }
        }
      ]
    },
    "slam": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "slam"
        },
        {
          "kind": "damage_player",
          "amount": 2,
          "radius": 24
        },
        {
          "kind": "emit",
          "event": "custom:slam"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
        {
          "to": "stalk",
          "when": {
            "kind": "timer_elapsed",
            "ms": 700
          }
        }
      ]
    },
    "aim": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "aim"
        },
        {
          "kind": "emit",
          "event": "custom:aim"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
        {
          "to": "volley",
          "when": {
            "kind": "timer_elapsed",
            "ms": 550
          }
        }
      ]
    },
    "volley": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "idle"
        },
        {
          "kind": "shoot_ring",
          "projectile": "ember",
          "count": 8,
          "speed": 46,
          "cooldownMs": 0
        }
      ],
      "update": [
        {
