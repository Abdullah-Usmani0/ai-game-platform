  "index.html": "<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hive Watch</title>
    <style>
      html, body { margin: 0; height: 100%; background: #0b0b14; overflow: hidden; }
      #game { width: 100%; height: 100%; }
      canvas { image-rendering: pixelated; }
    </style>
  </head>
  <body>
    <div id="game"></div>
    <script src="./engine.js"></script>
    <script src="./game.js"></script>
  </body>
</html>
",
  "package.json": "{
  "name": "game-pin-hive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && node scripts/finish-build.mjs",
    "prove": "GG_PROVE=1 vitest run tests/unit/prove.test.ts"
  }
}
",
  "scripts/finish-build.mjs": "// Copies index.html and the shared engine chunk next to the built game.js so dist/ is a servable bundle.
import { copyFileSync, existsSync, mkdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { createRequire } from 'node:module';

const here = fileURLToPath(new URL('..', import.meta.url));
const require = createRequire(import.meta.url);
const enginePkg = require.resolve('@gg/engine/package.json');
const engineDist = fileURLToPath(new URL('./dist/engine.js', \`file://\${enginePkg}\`));
if (!existsSync(engineDist)) throw new Error(\`engine chunk missing: \${engineDist} (run pnpm --filter @gg/engine build)\`);
mkdirSync(\`\${here}dist\`, { recursive: true });
copyFileSync(\`\${here}index.html\`, \`\${here}dist/index.html\`);
copyFileSync(engineDist, \`\${here}dist/engine.js\`);
const engineMeta = engineDist.replace(/engine\\.js$/, 'engine.json');
if (existsSync(engineMeta)) copyFileSync(engineMeta, \`\${here}dist/engine.json\`);
console.log('bundle ready in', \`\${here}dist\`);
",
  "src/game.ts": "import type { BehaviourFsm, EcaRule, EntityRoster, FreeformSystemsJson, LevelJson } from '@gg/schemas';
import type { FeedbackBinding, SimOptions } from '@gg/sdk';
import { simOptionsFor } from '@gg/template-core';
import { compose } from '@gg/template-freeform';
import rosterJson from '../content/entities.json';
import feedbackJson from '../design/feedback.json';
import systemsJson from '../design/systems.json';
import { BESPOKE } from './systems/index.js';

/** A freeform game on survivors: its systems from any genre's catalog, its roster's entities, composed at load. */
export const SYSTEMS = systemsJson as unknown as FreeformSystemsJson;
export const ROSTER = rosterJson as unknown as EntityRoster;
const runtime = compose(SYSTEMS, ROSTER).runtime;

function sorted<T>(mods: Record<string, T>): T[] {
  return Object.keys(mods)
    .sort()
    .map((k) => mods[k] as T);
}

const levelFiles = import.meta.glob('../content/levels/*.json', { eager: true, import: 'default' }) as Record<string, LevelJson>;
const behaviourFiles = import.meta.glob('../content/behaviour/*.fsm.json', { eager: true, import: 'default' }) as Record<string, BehaviourFsm>;
const ruleFiles = import.meta.glob('../content/rules/*.eca.json', { eager: true, import: 'default' }) as Record<string, EcaRule>;
const extraContent = import.meta.glob(['../content/*.json', '!../content/entities.json'], { eager: true, import: 'default' }) as Record<string, unknown>;

export const LEVELS: LevelJson[] = sorted(levelFiles);
export const FEEDBACK = feedbackJson as FeedbackBinding[];
export const CONTENT: Record<string, unknown> = Object.fromEntries(Object.entries(extraContent).map(([k, v]) => [k.replace(/^.*\\/([^/]+)\\.json$/, '$1'), v]));

/** The selected systems (in systems.json order), then bespoke systems, then the feedback binder; the roster's entities. */
export const SIM_OPTIONS: Omit<SimOptions, 'level' | 'seed'> = simOptionsFor(runtime, SYSTEMS, { behaviours: sorted(behaviourFiles), rules: sorted(ruleFiles), content: CONTENT, feedback: FEEDBACK, bespoke: BESPOKE });
export const BEHAVIOURS: BehaviourFsm[] = SIM_OPTIONS.behaviours ?? [];
export const RULES: EcaRule[] = SIM_OPTIONS.rules ?? [];
",
  "src/main.ts": "import type { StyleCard } from '@gg/schemas';
import { createGame } from '@gg/sdk/render';
import styleJson from '../design/style.json';
import { LEVELS, SIM_OPTIONS } from './game.js';

const style = styleJson as unknown as StyleCard;

void createGame({
  levels: LEVELS,
  sim: SIM_OPTIONS,
  build: { gameId: 'pin-hive', versionId: 'dev', engine: 'phaser-4.2.1/sdk-0.1.0' },
  style: {
    canvas: style.canvas,
    pixelArt: style.pixelArt,
    palette: { background: style.palette.background, mid: style.palette.mid, foreground: style.palette.foreground, accent: style.palette.accent, danger: style.palette.danger, ui: style.palette.ui },
    camera: { lerp: style.camera.lerp, maxShake: style.camera.maxShake, deadzone: style.camera.deadzone },
    outline: style.outline,
    postFx: style.postFx,
    animationFps: style.animationFps,
    genre: 'survivors',
    title: 'Hive Watch',
  },
  parent: 'game',
  defaultSeed: 1,
});
",
  "src/systems/index.ts": "import type { SystemDef } from '@gg/sdk';

/**
 * Bespoke simulation systems for this game. Add a file per system under src/systems/, written in GlueTS
 * with \`defineSystem\` from '@gg/sdk', list it here, and write its contract in design/mechanics.json: the game's
 * test holds the code to it. Template systems come from systems.json instead.
 */
// eslint-disable-next-line @typescript-eslint/no-explicit-any
export const BESPOKE: SystemDef<any>[] = [];
",
  "tests/unit/bots.ts": "import type { EntityRoster, FreeformSystemsJson, LevelProof } from '@gg/schemas';
import { freeformCheck } from '@gg/template-freeform/check';
import rosterJson from '../../content/entities.json';
import systemsJson from '../../design/systems.json';

const proofFiles = import.meta.glob('../../content/proofs/*.json', { eager: true, import: 'default' }) as Record<string, LevelProof>;
const kit = freeformCheck(systemsJson as unknown as FreeformSystemsJson, rosterJson as unknown as EntityRoster, Object.values(proofFiles));
/** The proof bot replays each level's recorded winning run; chaos presses keys at random. */
export const BOTS = kit.bots;
export const SOLVER_BOT = kit.solverBot;
",
  "tests/unit/game.test.ts": "import { MechanicsFile } from '@gg/schemas';
import { createSim, DEFAULT_SEED, levelSeed } from '@gg/sdk';
import { conformance, levelTicksOf, runBot } from '@gg/template-core';
import { describe, expect, it } from 'vitest';
import mechanicsJson from '../../design/mechanics.json';
import { LEVELS, SIM_OPTIONS } from '../../src/game.js';
import { BESPOKE } from '../../src/systems/index.js';
import { BOTS, SOLVER_BOT } from './bots.js';

const MECHANICS = MechanicsFile.parse(mechanicsJson).mechanics;

describe('freeform game', () => {
  it('every level is completable by the solver bot, at the seed the level is played with', () => {
    for (const [i, level] of LEVELS.entries()) {
      const result = runBot(createSim({ ...SIM_OPTIONS, level, seed: levelSeed(DEFAULT_SEED, i) }), BOTS[SOLVER_BOT]!, levelTicksOf(SIM_OPTIONS));
      expect(result.completed, \`level \${level.id} not completed (ticks=\${result.ticks} deaths=\${result.deaths})\`).toBe(true);
    }
  });
  it('is deterministic', () => {
    const level = LEVELS[0]!;
    const a = runBot(createSim({ ...SIM_OPTIONS, level, seed: 3 }), BOTS['chaos']!, 600);
    const b = runBot(createSim({ ...SIM_OPTIONS, level, seed: 3 }), BOTS['chaos']!, 600);
    expect(a.finalHash).toBe(b.finalHash);
  });
  // The game's own systems (src/systems) do what their contracts (design/mechanics.json) say, and keep the game sound.
  it.runIf(BESPOKE.length > 0 || MECHANICS.length > 0)('its own systems keep to their contracts', () => {
    const levels = LEVELS.map((level, i) => ({ level, seed: levelSeed(DEFAULT_SEED, i) }));
    const bots = { [SOLVER_BOT]: BOTS[SOLVER_BOT]!, chaos: BOTS['chaos']! };
    const r = conformance({ options: SIM_OPTIONS, levels, contracts: MECHANICS, bespoke: BESPOKE.map((s) => s.id), bots, ticks: levelTicksOf(SIM_OPTIONS) });
    expect(r.issues.filter((i) => i.severity === 'error')).toEqual([]);
  });
});
",
  "tests/unit/prove.test.ts": "import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { LevelProof, MechanicsFile } from '@gg/schemas';
import { BASE_MANIFESTS, proveLevel } from '@gg/template-freeform/node';
import { describe, expect, it } from 'vitest';
import mechanicsJson from '../../design/mechanics.json';
import { BEHAVIOURS, CONTENT, FEEDBACK, LEVELS, ROSTER, RULES, SYSTEMS } from '../../src/game.js';
import { BESPOKE } from '../../src/systems/index.js';

const proofs = fileURLToPath(new URL('../../content/proofs/', import.meta.url));

describe.runIf(process.env['GG_PROVE'] === '1')('winning runs', () => {
  it("every level gets one, played with the game's own systems: the stored run while it wins, else the solver, else the explorer", () => {
    const base = BASE_MANIFESTS[SYSTEMS.composition.base];
    const mechanics = MechanicsFile.parse(mechanicsJson).mechanics;
    mkdirSync(proofs, { recursive: true });
    for (const [i, level] of LEVELS.entries()) {
      const file = \`\${proofs}\${level.id}.json\`;
      const stored = existsSync(file) ? LevelProof.parse(JSON.parse(readFileSync(file, 'utf8'))) : undefined;
      const inputs = { file: SYSTEMS, roster: ROSTER, behaviours: BEHAVIOURS, rules: RULES, content: CONTENT, feedback: FEEDBACK, solver: base.bots[base.solverBot], bespoke: BESPOKE, mechanics, budget: 40_000 };
      const r = proveLevel(level, i, inputs, stored);
      expect(r.proof, \`\${level.id}: \${r.tried.join('; ')}\`).not.toBeNull();
      writeFileSync(file, JSON.stringify(r.proof) + '\\n');
    }
  });
});
",
  "tsconfig.json": "{ "extends": "@gg/config/tsconfig.browser.json", "compilerOptions": { "types": ["node", "vite/client"] }, "include": ["src", "tests"] }
",
  "vite.config.ts": "import { fileURLToPath } from 'node:url';
import { gameViteConfig } from '@gg/config/vite-game';
const root = fileURLToPath(new URL('.', import.meta.url));
export default gameViteConfig({ root, entry: 'src/main.ts' });
",
  "vitest.config.ts": "import { defineConfig } from 'vitest/config';
export default defineConfig({ test: { include: ['tests/**/*.test.ts'] } });
",
}
`;

