  "content/entities.json": "{
  "version": 1,
  "designNotes": "Grunts are guards, archers are sentries firing darts, brutes are enforcers, the warden is the vault keeper; gems are power cells and the auto-attack drops data shards.",
  "player": {},
  "types": [
    {
      "type": "guard",
      "archetype": "topdown-action:grunt",
      "hp": 1
    },
    {
      "type": "sentry",
      "archetype": "topdown-action:archer",
      "hp": 1
    },
    {
      "type": "dart",
      "archetype": "topdown-action:arrow",
      "hp": 1
    },
    {
      "type": "enforcer",
      "archetype": "topdown-action:brute",
      "hp": 1
    },
    {
      "type": "keeper",
      "archetype": "topdown-action:warden",
      "hp": 1
    },
    {
      "type": "cell",
      "archetype": "topdown-action:gem",
      "hp": 1
    },
    {
      "type": "shard",
      "archetype": "survivors:xp",
      "hp": 1
    }
  ]
}
