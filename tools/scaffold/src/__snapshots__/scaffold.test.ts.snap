          "anim": "run"
        }
      ],
      "update": [
        {
          "kind": "move_toward_player",
          "speed": 34
        }
      ],
      "transitions": [
        {
          "to": "windup",
          "when": {
            "kind": "player_within",
            "px": 16
          }
        },
        {
          "to": "stagger",
          "when": {
            "kind": "took_damage"
          }
        },
        {
          "to": "wait",
          "when": {
            "kind": "player_beyond",
