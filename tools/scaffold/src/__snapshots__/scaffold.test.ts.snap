  "content/behaviour/brute.fsm.json": "{
  "version": 1,
  "id": "brute",
  "designNotes": "Slow chaser with a long wind-up and a two-damage bite; staggers briefly when hit.",
  "initial": "wait",
  "states": {
    "wait": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "idle"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
