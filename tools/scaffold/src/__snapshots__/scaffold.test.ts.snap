        },
        {
          "kind": "emit",
          "event": "custom:windup"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
        {
          "to": "bite",
