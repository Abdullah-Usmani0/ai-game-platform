{
  "version": 1,
  "id": "grunt",
  "designNotes": "Waits in its room, rushes on sight, stops to wind up a bite (interruptible by a hit), staggers when hit, gives up when the player leaves.",
  "initial": "wait",
  "states": {
    "wait": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "idle"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
        {
          "to": "chase",
          "when": {
            "kind": "player_in_sight",
            "px": 84
          }
        },
        {
          "to": "chase",
          "when": {
            "kind": "took_damage"
          }
        }
      ]
    },
    "chase": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "run"
        }
      ],
      "update": [
        {
          "kind": "move_toward_player",
          "speed": 46
        }
      ],
      "transitions": [
        {
          "to": "windup",
          "when": {
            "kind": "player_within",
            "px": 13
          }
        },
        {
          "to": "stagger",
          "when": {
            "kind": "took_damage"
          }
        },
        {
          "to": "wait",
          "when": {
            "kind": "player_beyond",
            "px": 160
          }
        }
      ]
    },
    "windup": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "windup"
        },
        {
          "kind": "emit",
          "event": "custom:windup"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
        {
          "to": "stagger",
          "when": {
            "kind": "took_damage"
          }
        },
        {
          "to": "bite",
          "when": {
            "kind": "timer_elapsed",
            "ms": 300
          }
        }
      ]
    },
    "bite": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "bite"
        },
        {
          "kind": "damage_player",
          "amount": 1
        },
        {
          "kind": "emit",
          "event": "custom:bite"
        }
      ],
      "update": [
        {
          "kind": "set_velocity",
          "vx": 0,
          "vy": 0
        }
      ],
      "transitions": [
        {
          "to": "stagger",
          "when": {
            "kind": "took_damage"
          }
        },
        {
          "to": "chase",
          "when": {
            "kind": "timer_elapsed",
            "ms": 400
          }
        }
      ]
    },
    "stagger": {
      "onEnter": [
        {
          "kind": "play_anim",
          "anim": "hurt"
        },
        {
          "kind": "move_away_from_player",
          "speed": 70
        }
      ],
      "update": [],
      "transitions": [
        {
          "to": "chase",
          "when": {
            "kind": "timer_elapsed",
            "ms": 220
          }
        }
      ]
    }
  }
}
